APP_ENV=development
APP_ADDR=127.0.0.1:8080
APP_BASE_URL=http://127.0.0.1:8080
APP_SECURE_COOKIE=false
APP_PROJECT_ROOT=D:/A. ALAM-SEGAR
APP_HASH_KEY=local-development-only-change-me
# Kosongkan jika aplikasi dibuka langsung. Jika di belakang reverse proxy lokal,
# isi CIDR proxy yang benar agar limiter membaca rantai X-Forwarded-For secara aman.
APP_TRUSTED_PROXY_CIDRS=

# Gunakan akun database khusus pada staging/production.
# Nilai berikut hanya cocok untuk MariaDB/XAMPP lokal yang sudah disiapkan.
DATABASE_DSN=root@tcp(127.0.0.1:3306)/alam-segar?parseTime=true&loc=UTC&charset=utf8mb4&collation=utf8mb4_general_ci&multiStatements=true

# Antrean email. Gunakan log hanya untuk lokal; production sebaiknya smtp.
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@alamsegar.local

# Dipakai oleh perintah seed hanya pada APP_ENV=development.
DEV_OWNER_NAME=Pemilik Alam Segar
DEV_OWNER_EMAIL=pemilik@alamsegar.local
DEV_OWNER_PASSWORD=Ganti-Sebelum-Deploy-123!
# Opsional. Data ini diberi kode DEMO dan tidak boleh dipakai sebagai data nyata.
DEV_SEED_DEMO_DATA=false

